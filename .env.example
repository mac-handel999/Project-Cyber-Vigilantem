# Local environment. Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored, so keys stay out of version control. On Vercel these are
# already set under Settings > Environment Variables for Production and Preview.
#
# To pull the production values down instead of retyping them:
#   npx vercel env pull .env

# Google Safe Browsing API — powers /api/check-url
GOOGLE_SAFE_BROWSING_KEY=

# SerpApi — search results for /api/research and /api/generate-roadmap
SERP_API_KEY=

# Groq — LLM synthesis for /api/research and /api/generate-roadmap
GROQ_API_KEY=

# LeakCheck — breach lookup for /api/breach-check
LEAKCHECK_API_KEY=

# ipinfo.io — public IP telemetry for /api/ip-telemetry
IPINFO_API_KEY=
